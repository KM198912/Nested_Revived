<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rebuild of Myself086's private 65816/SPC700 assembler, so Assembly/ can be
       assembled again. Goal: v1.8 sources -> byte-identical Project_Nested.smc. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Nested.Assembler</RootNamespace>
    <AssemblyName>NestedAsm</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
